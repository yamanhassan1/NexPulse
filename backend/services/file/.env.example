PORT=8003
MONGODB_URI=mongodb://127.0.0.1:27017/nexpulse
REDIS_URL=redis://localhost:6379
NODE_ENV=development

# Must match the gateway's INTERNAL_SECRET (required in production).
INTERNAL_SECRET=
# Bind address. 127.0.0.1 keeps this service off the network; set
# 0.0.0.0 only when each service runs in its own container.
HOST=127.0.0.1
