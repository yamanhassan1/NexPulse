PORT=8000
FRONTEND_URL=http://localhost:5173
AUTH_SERVICE=http://localhost:8001
PROJECT_SERVICE=http://localhost:8002
FILE_SERVICE=http://localhost:8003
REDIS_URL=redis://localhost:6379
UPSTREAM_TIMEOUT_MS=15000
NODE_ENV=development

# Distributed Redis rate-limit thresholds.
LOGIN_RATE_LIMIT_MAX=30
WRITE_RATE_LIMIT_MAX=240
IMPORT_RATE_LIMIT_MAX=25
EXPORT_RATE_LIMIT_MAX=25

# Shared secret sent by the gateway to the internal services.
# Required in production; a browser never sees it.
INTERNAL_SECRET=
